# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /
# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"）
VITE_ROUTER_HISTORY = "hash"

# ---------------------------------------------------------------- 文档协同管理接口
# 同源路径经 Vite 代理转发，避免管理 API 暴露跨域；直连时写 http://localhost:8787
VITE_DOCS_ADMIN_BASE_URL = /internal/admin
# Vite 代理的后端地址，切回 Mock 时改为 http://localhost:9100 并清空上面的 base
VITE_DOCS_ADMIN_PROXY_TARGET = http://localhost:8787
# 本地开发管理 token，需与 API 侧 ADMIN_TOKEN 保持一致
VITE_DOCS_ADMIN_TOKEN = dev-admin-token
VITE_DOCS_ADMIN_OPERATOR_ID = admin-1
# 中文昵称可写原文，请求层会自动 URL 编码
VITE_DOCS_ADMIN_OPERATOR_NAME = 管理员
