# 复制为 .env 后修改，docker compose 会自动读取本目录的 .env
# 浏览器访问域名/IP。分片地址与 webhook 里的文档链接都用它拼出来
PUBLIC_HOST=localhost
# 前端对外端口
WEB_PORT=8080
# 协同分片对外端口（浏览器直连，需对客户端可达）
COLLAB_PUBLISH_PORT=1234

# 必填：生产环境请换成随机长字符串
JWT_SECRET=please-change-me-to-a-long-random-string

# 数据库密码
POSTGRES_PASSWORD=lingshu

# 可选：@提及 推送到灵犀（或任意兼容接收方），留空则只落站内通知
LINGXI_WEBHOOK_URL=
