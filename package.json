{
  "name": "lingshu",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @lingshu/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:init": "pnpm --filter @lingshu/api db:init",
    "loadtest:m0": "node apps/web/scripts/m0-loadtest.mjs",
    "fps:m0": "node apps/web/scripts/m0-fps.mjs",
    "bridge:m0": "node apps/web/scripts/m0-bridge.mjs",
    "routing:m0": "node apps/web/scripts/m0-routing.mjs",
    "accept:m1": "node apps/web/scripts/m1-acceptance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
