# 复制为 .env 后按需修改

# ---------------------------------------------------------------- 登录模式
# local：使用本项目的账号密码登录（默认，供开发与压测）
# im：信任 IM 签发的 token，账号密码登录自动关闭
AUTH_MODE=local
# 取当前用户的完整地址（经 IM 网关）；im 模式下留空会导致所有请求返回 503
# HuLa-Server：http://im-gateway:8080/oauth/anyone/getUserInfo（Sa-Token，Token 头、无前缀）
# 若依 RuoYi：http://im:8080/getInfo（Bearer 前缀）
IM_USERINFO_URL=
# IM token 所在的请求头与前缀（前缀尾部空格会被 .env 去掉，代码会自动补齐）
IM_TOKEN_HEADER=Token
IM_TOKEN_PREFIX=
IM_USERINFO_TIMEOUT_MS=5000
# token 到用户信息的缓存时长（毫秒），减少对 IM 用户接口的调用
IM_USER_CACHE_TTL_MS=60000

# ---------------------------------------------------------------- 管理端接口
# 服务令牌：与用户 token 完全隔离；留空时 /internal/admin/* 一律返回 404
INTERNAL_ADMIN_TOKEN=
# 允许调用管理 API 的来源 IP，逗号分隔；留空则不限制（生产环境建议配置）
# 直连时按 socket 远端地址匹配；经反向代理时请把代理地址加入白名单（不再信任可伪造的 X-Forwarded-For）
INTERNAL_ADMIN_IPS=

# ---------------------------------------------------------------- API
API_PORT=8787
DATABASE_URL=postgres://lingshu:lingshu@localhost:5432/lingshu
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me

# 协同分片列表，用 | 分隔。API 按 document_id 一致性哈希后返回对应分片地址。
# 生产环境应填负载均衡后的固定入口，并保证哈希规则与 LB 一致。
COLLAB_SHARDS=ws://localhost:1234|ws://localhost:1235

# ---------------------------------------------------------------- 对象存储（MinIO）
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lingshu

# ---------------------------------------------------------------- 协同网关
# 每个分片进程设置不同的 SHARD_ID / COLLAB_PORT
SHARD_ID=shard-a
COLLAB_PORT=1234
# 单文档连接上限：按设计文档，200 人单文档是硬上限，不做无限弹性
COLLAB_MAX_DOC_CONNECTIONS=200
# awareness 合并广播的最小间隔（毫秒），对应 20-30 次/秒的上限
AWARENESS_THROTTLE_MS=40

# ---------------------------------------------------------------- 通知
# @提及 推送到灵犀（或任意兼容的接收方）；留空则只落站内通知
LINGXI_WEBHOOK_URL=
# webhook 里文档链接的前缀，需与前端部署地址一致
WEB_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------- 前端
VITE_API_BASE_URL=http://localhost:8787
